def schema_pass(env_path, schema_keys):
    try:
        load_dotenv(env_path)

        keys = [k.strip() for k in schema_keys.split(",")]

        for key in keys:
            schema_password = os.getenv(key)

            if not schema_password:
                logging.info(f"Password not found for {key}")
                continue

            time.sleep(10)
            pyautogui.write(schema_password)
            time.sleep(2)
            pyautogui.press("enter")

            logging.info(f"Entered password for {key}")

        time.sleep(20)

        logging.info("sending TAB Twice")
        send_keys("{TAB}{TAB}")
        time.sleep(2)

        logging.info("Sending UP...")
        send_keys("{UP 2}")
        time.sleep(2)

        logging.info("Sending ENTER...")
        send_keys("{ENTER}")
        time.sleep(10)

    except Exception as e:
        logging.error(f"Error in schema_pass: {e}")





elif "schema pass" in action:
    logging.info("Executing Schema Pass")

    try:
        env_path, schema_keys = map(str.strip, inputs.split("|"))
        schema_pass(env_path, schema_keys)
