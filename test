# ---------------- FUNCTIONS ----------------

function Write-Log {
    param([string]$Message)
    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "[$time] $Message"
    Write-Output $line
    $line | Out-File -Append -FilePath $LogPath -Encoding UTF8
}

function Backup-OutFiles {
    param($Agent)

    $PrimaryPath   = $primaryoutfile_path[$Agent]
    $SecondaryPath = $secondaryoutfile_path[$Agent]
    $HostName   = $env:COMPUTERNAME

    function Get-ValidSource {
        param($cutoffTime)

        if ($PrimaryPath -and (Test-Path $PrimaryPath)) {
            $out = Get-ChildItem $PrimaryPath -Filter "*.out" -File | Where-Object { $_.LastWriteTime -ge $cutoffTime }
            $tsv = Get-ChildItem $PrimaryPath -Filter "*.tsv" -File | Where-Object { $_.LastWriteTime -ge $cutoffTime }

            if ($out.Count -gt 0 -and $tsv.Count -gt 0) {
                return @{ Path = $PrimaryPath; Tag = "UNC" }
            }
        }

        if ($SecondaryPath -and (Test-Path $SecondaryPath)) {
            $out = Get-ChildItem $SecondaryPath -Filter "*.out" -File | Where-Object { $_.LastWriteTime -ge $cutoffTime }
            $tsv = Get-ChildItem $SecondaryPath -Filter "*.tsv" -File | Where-Object { $_.LastWriteTime -ge $cutoffTime }

            if ($out.Count -gt 0 -and $tsv.Count -gt 0) {
                return @{ Path = $SecondaryPath; Tag = "Client" }
            }
        }

        return $null
    }

    $cutoffTime = (Get-Date).AddHours(-24)
    $result = Get-ValidSource -cutoffTime $cutoffTime

    if (-not $result) {
        Write-Log "WARNING: Files not found for $Agent. Retrying in 1 minute"
        Start-Sleep 60
        $result = Get-ValidSource -cutoffTime $cutoffTime
        if (-not $result) { exit 1 }
    }

    $SourcePath = $result.Path
    $SourceTag  = $result.Tag

    if (-not (Test-Path $backup_path)) {
        New-Item -ItemType Directory -Path $backup_path | Out-Null
    }

    $RunTime = Get-Date -Format "yyyyMMdd_HHmmss"
    $RunBackupFolder = Join-Path $backup_path "${HostName}_${SourceTag}_${RunTime}"
    New-Item -ItemType Directory -Path $RunBackupFolder | Out-Null

    $files = Get-ChildItem $SourcePath -File | Where-Object {
        $_.LastWriteTime -ge $cutoffTime -and
        $_.Extension -in ".out",".tsv",".wrn",".err"
    }

    foreach ($f in $files) {
        Copy-Item $f.FullName (Join-Path $RunBackupFolder $f.Name) -Force
    }

    Write-Log "Backup completed for $Agent → $RunBackupFolder"

    return $RunBackupFolder
}

function Build-HTMLReport {
    param($Title, $Agents, $DownAgents)
    $HostName = $env:COMPUTERNAME
    $html = "<html><body><h2>$Title</h2><h3>Host: $HostName</h3><table border='1'>"

    foreach ($a in $Agents) {
        if ($DownAgents -contains $a) {
            $html += "<tr><td>$a</td><td style='color:red'>DOWN</td></tr>"
        }
        else {
            $html += "<tr><td>$a</td><td style='color:green'>RUNNING</td></tr>"
        }
    }

    $html += "</table></body></html>"
    return $html
}

function Send-EmailHtml {
    param($Subject, $HtmlBody, $Recipients)

    Send-MailMessage -From $From -To $Recipients -Subject $Subject -Body $HtmlBody -SmtpServer $SmtpServer -BodyAsHtml
}

function Check-Agents {
    param($Agents)

    $cmdLines = wmic process where "name like '%ompeditor%'" get CommandLine /VALUE |
        Select-String "^CommandLine=" |
        ForEach-Object { $_.ToString().Replace("CommandLine=","").Trim() }

    $down = @()

    foreach ($a in $Agents) {
        if (-not ($cmdLines -match $a)) {
            $down += $a
        }
    }

    $html = Build-HTMLReport "Agent Status Report" $Agents $down
    return @{ DownAgents=$down; Html=$html }
}

