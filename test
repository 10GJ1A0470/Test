    $BackupNote = "<p><b>Note:</b> Backup also taken for failed agent logs.</p>"

    $BackupLink = ""

    if ($LatestBackupPath) {

        # Convert path to clickable file URL
        $fileUrl = "file:///" + ($LatestBackupPath -replace "\\","/")

        $BackupLink = @"
<p>
<b>Backup Folder:</b><br/>
<a href='$fileUrl'>$LatestBackupPath</a>
</p>
"@
    }

    $FinalBody = $afterFirstRem.Html + $BackupNote + $BackupLink
