function Backup-OutFiles {
    param($Agent)

    $PrimaryPath   = $primaryoutfile_path[$Agent]
    $SecondaryPath = $secondaryoutfile_path[$Agent]

    $HostName  = $env:COMPUTERNAME
    $cutoffTime = (Get-Date).AddHours(-24)

    $AllSourcePaths = @()

    # Validate paths
    if ($PrimaryPath -and (Test-Path $PrimaryPath)) {
        Write-Log "Primary path found for $Agent : $PrimaryPath"
        $AllSourcePaths += $PrimaryPath
    }

    if ($SecondaryPath -and (Test-Path $SecondaryPath)) {
        Write-Log "Secondary path found for $Agent : $SecondaryPath"
        $AllSourcePaths += $SecondaryPath
    }

    if ($AllSourcePaths.Count -eq 0) {
        Write-Log "CRITICAL: Neither Primary nor Secondary path exists for $Agent"
        exit 1
    }

    # ---------------- MANDATORY CHECK (.out & .tsv in last 24hrs) ----------------

    $outFiles = @()
    #$tsvFiles = @()

    foreach ($SourcePath in $AllSourcePaths) {

        $outFiles += Get-ChildItem $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue |
                     Where-Object { $_.LastWriteTime -ge $cutoffTime }

        #$tsvFiles += Get-ChildItem $SourcePath -Filter "*.tsv" -File -ErrorAction SilentlyContinue |
        #             Where-Object { $_.LastWriteTime -ge $cutoffTime }
    }

    if ($outFiles.Count -eq 0) {

        Write-Log "WARNING: Mandatory files not found for $Agent. Waiting 1 minute and retrying..."
        Start-Sleep -Seconds 60
        $cutoffTime = (Get-Date).AddHours(-24)

        $outFiles = @()
        #$tsvFiles = @()

        foreach ($SourcePath in $AllSourcePaths) {

            $outFiles += Get-ChildItem $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue |
                         Where-Object { $_.LastWriteTime -ge $cutoffTime }

            #$tsvFiles += Get-ChildItem $SourcePath -Filter "*.tsv" -File -ErrorAction SilentlyContinue |
            #             Where-Object { $_.LastWriteTime -ge $cutoffTime }
        }

        if ($outFiles.Count -eq 0) {

            Write-Log "CRITICAL: Mandatory .out still missing for $Agent after retry."

            $HtmlBody = @"
<h2 style='color:red'>CRITICAL: Mandatory Agent Logs Missing</h2>
<p>
Agent <b>$Agent</b> on host <b>$HostName</b><br/>
No <b>.out</b> and/or <b>.tsv</b> files found in the last <b>24 hours</b>, even after retry.<br/><br/>
<b>Backup aborted and script terminated.</b>
</p>
"@

            Send-EmailHtml `
                -Subject "CRITICAL: $HostName Agent Logs Missing for $Agent" `
                -HtmlBody $HtmlBody `
                -Recipients $ToInitial

            exit 1
        }
    }

    # ---------------- CREATE SINGLE BACKUP FOLDER ----------------

    if (-not (Test-Path $backup_path)) {
        New-Item -ItemType Directory -Path $backup_path -Force | Out-Null
    }

    $RunTime = Get-Date -Format "yyyyMMdd_HHmmss"
    $RunBackupFolder = Join-Path $backup_path "${HostName}_${RunTime}"
    New-Item -ItemType Directory -Path $RunBackupFolder -Force | Out-Null

    Write-Log "Created backup folder: $RunBackupFolder"
	
	
	Write-Log "Waiting 120 seconds before starting backup to allow secondary path files to update..."

	Start-Sleep -Seconds 10

	Write-Log "Backup process started after wait."

    # ---------------- COPY FILES ----------------

    $TotalCopied = 0

    foreach ($SourcePath in $AllSourcePaths) {

        $files = Get-ChildItem $SourcePath -File -ErrorAction SilentlyContinue |
                 Where-Object {
                     $_.LastWriteTime -ge $cutoffTime -and
                     $_.Extension -in ".out",".wrn",".err"
                 }

        foreach ($f in $files) {
            Copy-Item $f.FullName (Join-Path $RunBackupFolder $f.Name) -Force
            Write-Log "BACKUP SUCCESS [$Agent] : $($f.FullName)"
            $TotalCopied++
        }
    }

    Write-Log "BACKUP SUMMARY [$Agent] : Total files backed up = $TotalCopied"

    return $RunBackupFolder
}



function Build-HTMLReport {
    param($Title, $Agents, $DownAgents)
	$HostName = $env:COMPUTERNAME
    $html = "<html><body><h2>$Title</h2><h3>Host: $HostName</h3><table border='1'>"
    foreach ($a in $Agents) {
        if ($DownAgents -contains $a) {
            $html += "<tr><td>$a</td><td style='color:red'>DOWN</td></tr>"
        } else {
            $html += "<tr><td>$a</td><td style='color:green'>RUNNING</td></tr>"
        }
    }
    $html += "</table></body></html>"
    return $html
}

function Send-EmailHtml {
    param($Subject, $HtmlBody, $Recipients)
    if ([string]::IsNullOrWhiteSpace($Recipients)) {
        Write-Log "ERROR: No recipients specified for email: $Subject"
        return
    }
    Send-MailMessage -From $From -To $Recipients -Subject $Subject -Body $HtmlBody -SmtpServer $SmtpServer -BodyAsHtml
    Write-Log "Email sent to ${Recipients}: ${Subject}"
}


function Run-DbBatch {
    param($Path)
    
    if (-not (Test-Path $Path)) { 
        Write-Log "DB batch not found: $Path"
        return $false 
    }

    # Load encrypted password
    $SecurePass = Get-Content "\\awsusdmkfsxn01.jnj.com\mdd_omp_dev\Automation Script\Agent_Monitoring\devdbpass.txt" | ConvertTo-SecureString
    $PlainPass  = [Runtime.InteropServices.Marshal]::PtrToStringAuto(
                    [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecurePass)
                  )

    Write-Log "Running DB batch via CMD (timeout 60s): $Path"

    $proc = Start-Process -FilePath $Path `
                      -ArgumentList $PlainPass `
                      -PassThru -NoNewWindow -ErrorAction SilentlyContinue

    # Wait max 60 seconds for db_status.txt to appear
    $dbStatusFile = Join-Path (Split-Path $Path) "db_status.txt"
    $stopwatch = [Diagnostics.Stopwatch]::StartNew()
    while (-not (Test-Path $dbStatusFile) -and $stopwatch.Elapsed.TotalSeconds -lt 20) {
        Start-Sleep -Seconds 2
    }
    $stopwatch.Stop()

    if (Test-Path $dbStatusFile) {
        Write-Log "----- DB Script Output Start -----"
        Get-Content $dbStatusFile | ForEach-Object { Write-Log $_ }
        Write-Log "----- DB Script Output End -----"
        return $true
    }
    else {
        Write-Log "ERROR: db_status.txt not created within 60 seconds. Possible DB login/password issue."

        $HostName = $env:COMPUTERNAME
        $HtmlBody = "<h2 style='color:red'>CRITICAL: DB Login Timeout</h2>
        <p style='color:red'>Failed to Login DB/Remove Inactive Lock Sessions on $HostName.<br/>
        Please check DB password and login issues.</p>"
        Send-EmailHtml -Subject "CRITICAL: DB Login Timeout on $HostName" -HtmlBody $HtmlBody -Recipients $ToInitial

        Write-Log "DB login timeout. Stopping script."
        exit 1   # terminate script
    }
}




