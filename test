function Backup-OutFiles {
    param($Agent)

    $SourcePath = $outfile_path[$Agent]
    if (-not (Test-Path $SourcePath)) {
        Write-Log "WARNING: Outfile path not found for $Agent : $SourcePath"
        return
    }

    $AgentBackupPath = Join-Path $backup_path $Agent
    if (-not (Test-Path $AgentBackupPath)) {
        New-Item -ItemType Directory -Path $AgentBackupPath -Force | Out-Null
        Write-Log "Created backup folder: $AgentBackupPath"
    }

    $today = (Get-Date).Date

    # -------- FIRST CHECK (same day) --------
    $outFiles = Get-ChildItem $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue |
                Where-Object { $_.LastWriteTime.Date -eq $today }

    $tsvFiles = Get-ChildItem $SourcePath -Filter "*.tsv" -File -ErrorAction SilentlyContinue |
                Where-Object { $_.LastWriteTime.Date -eq $today }

    # -------- MANDATORY CHECK --------
    if ($outFiles.Count -eq 0 -or $tsvFiles.Count -eq 0) {

        Write-Log "Mandatory same-day .out or .tsv files missing for $Agent. Waiting 1 minute..."
        Start-Sleep -Seconds 60

        # Re-check after wait
        $outFiles = Get-ChildItem $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue |
                    Where-Object { $_.LastWriteTime.Date -eq $today }

        $tsvFiles = Get-ChildItem $SourcePath -Filter "*.tsv" -File -ErrorAction SilentlyContinue |
                    Where-Object { $_.LastWriteTime.Date -eq $today }

        if ($outFiles.Count -eq 0 -or $tsvFiles.Count -eq 0) {

            Write-Log "CRITICAL: Same-day .out and/or .tsv files still missing for $Agent after 1 minute."

            $HostName = $env:COMPUTERNAME
            $HtmlBody = @"
<h2 style='color:red'>CRITICAL: Mandatory Logs Missing</h2>
<p>
Agent <b>$Agent</b> on host <b>$HostName</b><br/>
Same-day <b>.out</b> and <b>.tsv</b> files are mandatory but were not found even after waiting 1 minute.<br/><br/>
<b>Backup aborted and script stopped.</b>
</p>
"@

            Send-EmailHtml `
                -Subject "CRITICAL: Mandatory logs missing for $Agent on $HostName" `
                -HtmlBody $HtmlBody `
                -Recipients $ToInitial

            exit 1
        }
    }

    # -------- BACKUP ALL SAME-DAY LOGS --------
    $allFiles = Get-ChildItem $SourcePath -Include "*.out","*.tsv","*.wrn","*.err" -File -ErrorAction SilentlyContinue |
                Where-Object { $_.LastWriteTime.Date -eq $today }

    foreach ($f in $allFiles) {
        Copy-Item $f.FullName (Join-Path $AgentBackupPath $f.Name) -Force
        Write-Log "Backed up today's file $($f.Name) for $Agent"
    }
}
