# ---------------- FUNCTIONS ----------------
function Write-Log {
    param([string]$Message)
    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "[$time] $Message"
    Write-Output $line
    $line | Out-File -Append -FilePath $LogPath -Encoding UTF8
}

function Backup-OutFiles {
    param([string]$SourcePath, [string]$BackupPath)

    Write-Log "Starting .out file backup from $SourcePath"

    if (-not (Test-Path $SourcePath)) {
        Write-Log "WARNING: Source path not found: $SourcePath"
        return
    }

    if (-not (Test-Path $BackupPath)) {
        Write-Log "Backup path not found. Creating $BackupPath"
        New-Item -ItemType Directory -Path $BackupPath -Force | Out-Null
    }

    $files = Get-ChildItem -Path $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue
    if ($files.Count -eq 0) {
        Write-Log "No .out files found."
        return
    }

    foreach ($f in $files) {
        Copy-Item $f.FullName (Join-Path $BackupPath $f.Name) -Force
        Write-Log "Backed up: $($f.Name)"
    }

    Write-Log "Outfile backup completed."
}

function Build-HTMLReport {
    param($Title, $Agents, $DownAgents)
    $HostName = $env:COMPUTERNAME
    $html = "<html><body><h2>$Title</h2><h3>Host: $HostName</h3><table border='1'>"
    foreach ($a in $Agents) {
        if ($DownAgents -contains $a) {
            $html += "<tr><td>$a</td><td style='color:red'>DOWN</td></tr>"
        } else {
            $html += "<tr><td>$a</td><td style='color:green'>RUNNING</td></tr>"
        }
    }
    $html += "</table></body></html>"
    return $html
}

function Send-EmailHtml {
    param($Subject, $HtmlBody, $Recipients)
    Send-MailMessage -From $From -To $Recipients -Subject $Subject -Body $HtmlBody -SmtpServer $SmtpServer -BodyAsHtml
    Write-Log "Email sent: $Subject"
}

function Run-DbBatch {
