# ---------------- FUNCTIONS ----------------
function Write-Log {
    param([string]$Message)
    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "[$time] $Message"
    Write-Output $line
    $line | Out-File -Append -FilePath $LogPath -Encoding UTF8
}

function Build-HTMLReport {
    param($Title, $Agents, $DownAgents)
    $HostName = $env:COMPUTERNAME
    $html = "<html><body><h2>$Title</h2><h3>Host: $HostName</h3><table border='1'>"
    foreach ($a in $Agents) {
        if ($DownAgents -contains $a) {
            $html += "<tr><td>$a</td><td style='color:red'>DOWN</td></tr>"
        } else {
            $html += "<tr><td>$a</td><td style='color:green'>RUNNING</td></tr>"
        }
    }
    $html += "</table></body></html>"
    return $html
}

function Send-EmailHtml {
    param($Subject, $HtmlBody, $Recipients)
    Send-MailMessage -From $From -To $Recipients -Subject $Subject -Body $HtmlBody -SmtpServer $SmtpServer -BodyAsHtml
    Write-Log "Email sent: $Subject"
}

# 🔥 BACKUP FUNCTION (COPY .out FILES)
function Backup-OutFiles {
    param($SourcePath, $BackupPath)

    if (-not (Test-Path $SourcePath)) {
        Write-Log "Backup skipped. Source path missing: $SourcePath"
        return
    }

    if (-not (Test-Path $BackupPath)) {
        New-Item -ItemType Directory -Path $BackupPath -Force | Out-Null
        Write-Log "Backup directory created: $BackupPath"
    }

    $files = Get-ChildItem $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue
    if ($files.Count -eq 0) {
        Write-Log "No .out files found to backup."
        return
    }

    foreach ($f in $files) {
        try {
            Copy-Item $f.FullName (Join-Path $BackupPath $f.Name) -Force
            Write-Log "Copied .out file: $($f.Name)"
        } catch {
            Write-Log "ERROR copying $($f.Name): $_"
        }
    }
}

function Run-DbBatch {
    param($Path)
    if (-not (Test-Path $Path)) { Write-Log "DB batch not found"; return $false }

    $SecurePass = Get-Content "\\awsusdmkfsxn01.jnj.com\mdd_omp_dev\OMP_JNJ_MD_ATOMSP_DEV\OMPartners\spdevelopment\dispatcher\bin\Automation\Agent\devdbpass.txt" | ConvertTo-SecureString
    $PlainPass = [Runtime.InteropServices.Marshal]::PtrToStringAuto(
        [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecurePass)
    )

    Start-Process -FilePath $Path -ArgumentList $PlainPass -NoNewWindow
    Start-Sleep -Seconds 5
    return $true
}

function Run-PythonStart {
    param($PyPath)
    & $PythonExe "`"$PyPath`"" 2>&1 | ForEach-Object { Write-Log "[PY] $_" }
}

function Check-Agents {
    param($Agents)
    $cmdLines = wmic process where "name like '%ompeditor%'" get CommandLine /VALUE |
        Select-String "^CommandLine=" | ForEach-Object {
            $_.ToString().Replace("CommandLine=", "").Trim()
        }

    $down = @()
    foreach ($a in $Agents) {
        if (-not ($cmdLines -match [regex]::Escape($a))) {
            $down += $a
        }
    }

    return @{
        DownAgents = $down
        Html = Build-HTMLReport "Agent Status Report" $Agents $down
    }
}

