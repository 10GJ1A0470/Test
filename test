function Check-Agents {
    param($Agents)

    $cmdLines = wmic process where "name like '%ompeditor%'" get CommandLine /VALUE |
        Select-String "^CommandLine=" | ForEach-Object {
            $_.ToString().Replace("CommandLine=", "").Trim()
        }

    $down = @()

    foreach ($a in $Agents) {

        $matched = $false

        foreach ($c in $cmdLines) {

            if ($c -match [regex]::Escape($a)) {
                $matched = $true
                break
            }

        }

        if (-not $matched) {
            $down += $a
        }

    }

    $html = Build-HTMLReport -Title "Agent Status Report" -Agents $Agents -DownAgents $down

    return @{
        DownAgents = $down
        Html       = $html
    }
}






$cmdLines = Get-CimInstance Win32_Process |
            Where-Object { $_.CommandLine -like "*ompeditor*" } |
            Select-Object -ExpandProperty CommandLine
