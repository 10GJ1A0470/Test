function Write-Log {
    param([string]$Message)
    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "[$time] $Message"
    Write-Output $line
    $line | Out-File -Append -FilePath $LogPath -Encoding UTF8
}

##New part



function Backup-OutFiles {
    param($Agent)

    $SourcePath = $outfile_path[$Agent]
    if (-not (Test-Path $SourcePath)) {
        Write-Log "WARNING: Outfile path not found for $Agent : $SourcePath"
        return
    }

    $AgentBackupPath = Join-Path $backup_path $Agent
    if (-not (Test-Path $AgentBackupPath)) {
        New-Item -ItemType Directory -Path $AgentBackupPath -Force | Out-Null
        Write-Log "Created backup folder: $AgentBackupPath"
    }

    # -------- TIME WINDOW (200 minutes) --------
    $cutoffTime = (Get-Date).AddMinutes(-200)

    # -------- MANDATORY FILE CHECK --------
    $outFiles = Get-ChildItem $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue |
                Where-Object { $_.LastWriteTime -ge $cutoffTime }

    $tsvFiles = Get-ChildItem $SourcePath -Filter "*.tsv" -File -ErrorAction SilentlyContinue |
                Where-Object { $_.LastWriteTime -ge $cutoffTime }

    if ($outFiles.Count -eq 0 -or $tsvFiles.Count -eq 0) {

        Write-Log "Mandatory .out/.tsv not found in last 200 minutes for $Agent. Waiting 1 minute..."
        Start-Sleep -Seconds 60

        $cutoffTime = (Get-Date).AddMinutes(-200)

        $outFiles = Get-ChildItem $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue |
                    Where-Object { $_.LastWriteTime -ge $cutoffTime }

        $tsvFiles = Get-ChildItem $SourcePath -Filter "*.tsv" -File -ErrorAction SilentlyContinue |
                    Where-Object { $_.LastWriteTime -ge $cutoffTime }

        if ($outFiles.Count -eq 0 -or $tsvFiles.Count -eq 0) {

            Write-Log "CRITICAL: Mandatory .out/.tsv still missing for $Agent after retry."

            $HostName = $env:COMPUTERNAME
            $HtmlBody = @"
<h2 style='color:red'>CRITICAL: Mandatory Agent Logs Missing</h2>
<p>
Agent <b>$Agent</b> on host <b>$HostName</b><br/>
No <b>.out</b> and/or <b>.tsv</b> files found in the last <b>2000 minutes</b>, even after retry.<br/><br/>
<b>Backup aborted and script terminated.</b>
</p>
"@

            Send-EmailHtml `
                -Subject "CRITICAL: $HostName Agent Down Logs missing for $Agent" `
                -HtmlBody $HtmlBody `
                -Recipients $ToInitial

            exit 1
        }
    }

    # -------- BACKUP ALL RELEVANT FILES (FIXED) --------
    $allFiles = Get-ChildItem $SourcePath -File -ErrorAction SilentlyContinue |
                Where-Object {
                    $_.LastWriteTime -ge $cutoffTime -and
                    $_.Extension -in ".out",".tsv",".wrn",".err"
                }

    if ($allFiles.Count -eq 0) {
        Write-Log "No eligible files found for backup for $Agent after filtering."
        return
    }

    $backupCount = 0
    foreach ($f in $allFiles) {
        Copy-Item $f.FullName (Join-Path $AgentBackupPath $f.Name) -Force
        Write-Log "BACKUP SUCCESS [$Agent] : $($f.Name) | LastWriteTime = $($f.LastWriteTime)"
        $backupCount++
    }

    Write-Log "BACKUP SUMMARY [$Agent] : Total files backed up = $backupCount"
}


function Build-HTMLReport {
    param($Title, $Agents, $DownAgents)
	$HostName = $env:COMPUTERNAME
    $html = "<html><body><h2>$Title</h2><h3>Host: $HostName</h3><table border='1'>"
    foreach ($a in $Agents) {
        if ($DownAgents -contains $a) {
            $html += "<tr><td>$a</td><td style='color:red'>DOWN</td></tr>"
        } else {
            $html += "<tr><td>$a</td><td style='color:green'>RUNNING</td></tr>"
        }
    }
    $html += "</table></body></html>"
    return $html
}

function Send-EmailHtml {
    param($Subject, $HtmlBody, $Recipients)
    if ([string]::IsNullOrWhiteSpace($Recipients)) {
        Write-Log "ERROR: No recipients specified for email: $Subject"
        return
    }
    Send-MailMessage -From $From -To $Recipients -Subject $Subject -Body $HtmlBody -SmtpServer $SmtpServer -BodyAsHtml
    Write-Log "Email sent to ${Recipients}: ${Subject}"
}


function Run-DbBatch {
    param($Path)
    
    if (-not (Test-Path $Path)) { 
        Write-Log "DB batch not found: $Path"
        return $false 
    }

    # Load encrypted password
    $SecurePass = Get-Content "\\awsusdmlfsxn01.jnj.com\opt_pdev3_omp_na\OMP_JNJ_CMD_OPTMS_LAB\OMPartners\development\dispatcher\bin\Automation\Agent\devdbpass.txt" | ConvertTo-SecureString
    $PlainPass  = [Runtime.InteropServices.Marshal]::PtrToStringAuto(
                    [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecurePass)
                  )

    Write-Log "Running DB batch via CMD (timeout 60s): $Path"

    $proc = Start-Process -FilePath $Path `
                      -ArgumentList $PlainPass `
                      -PassThru -NoNewWindow -ErrorAction SilentlyContinue

    # Wait max 60 seconds for db_status.txt to appear
    $dbStatusFile = Join-Path (Split-Path $Path) "db_status.txt"
    $stopwatch = [Diagnostics.Stopwatch]::StartNew()
    while (-not (Test-Path $dbStatusFile) -and $stopwatch.Elapsed.TotalSeconds -lt 20) {
        Start-Sleep -Seconds 2
    }
    $stopwatch.Stop()

    if (Test-Path $dbStatusFile) {
        Write-Log "----- DB Script Output Start -----"
        Get-Content $dbStatusFile | ForEach-Object { Write-Log $_ }
        Write-Log "----- DB Script Output End -----"
        return $true
    }
    else {
        Write-Log "ERROR: db_status.txt not created within 60 seconds. Possible DB login/password issue."

        $HostName = $env:COMPUTERNAME
        $HtmlBody = "<h2 style='color:red'>CRITICAL: DB Login Timeout</h2>
        <p style='color:red'>Failed to Login DB/Remove Inactive Lock Sessions on $HostName.<br/>
        Please check DB password and login issues.</p>"
        Send-EmailHtml -Subject "CRITICAL: DB Login Timeout on $HostName" -HtmlBody $HtmlBody -Recipients $ToInitial

        Write-Log "DB login timeout. Stopping script."
        exit 1   # terminate script
    }
}




function Run-PythonStart {
    param($PyPath)
    if (-not (Test-Path $PyPath)) { Write-Log "Python script not found: $PyPath"; return $false }
    if (-not (Test-Path $PythonExe)) { Write-Log "Python executable not found: $PythonExe"; return $false }
    Write-Log "Running Python start: $PyPath"
    
    $output = & $PythonExe "`"$PyPath`"" 2>&1
    $output | ForEach-Object { Write-Log "[PY] $_" }
    
    if ($LASTEXITCODE -eq 0) {
        Write-Log "Python script completed successfully."
        return $true
    } else {
        Write-Log "Python script failed with exit code $LASTEXITCODE."
        return $false
    }
}

function Check-Agents {
    param($Agents)

    $cmdLines = wmic process where "name like '%ompeditor%'" get CommandLine /VALUE |
        Select-String "^CommandLine=" | ForEach-Object {
            $_.ToString().Replace("CommandLine=", "").Trim()
        }

    $down = @()
    foreach ($a in $Agents) {
        $matched = $false
        foreach ($c in $cmdLines) {
            if ($c -match "/database=\{.*$([regex]::Escape($a)).*\}") {
                $matched = $true
                break
            }
        }
        if (-not $matched) { $down += $a }
    }

    $html = Build-HTMLReport -Title "Agent Status Report" -Agents $Agents -DownAgents $down
    return @{ DownAgents = $down; Html = $html }
}

