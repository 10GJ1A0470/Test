function Backup-OutFiles {
    param($Agent)

    $SourcePath = $outfile_path[$Agent]
    if (-not (Test-Path $SourcePath)) {
        Write-Log "WARNING: Outfile path not found for $Agent : $SourcePath"
        return
    }

    $AgentBackupPath = Join-Path $backup_path $Agent
    if (-not (Test-Path $AgentBackupPath)) {
        New-Item -ItemType Directory -Path $AgentBackupPath -Force | Out-Null
        Write-Log "Created backup folder: $AgentBackupPath"
    }

    $today = (Get-Date).Date

    # -------- FIRST CHECK --------
    $extensionsFirst = @("*.out", "*.wrn", "*.tsv", "*.err")

    $files = foreach ($ext in $extensionsFirst) {
        Get-ChildItem $SourcePath -Filter $ext -File -ErrorAction SilentlyContinue |
        Where-Object { $_.LastWriteTime.Date -eq $today }
    }

    # -------- IF NOTHING FOUND, WAIT & RECHECK --------
    if (-not $files -or $files.Count -eq 0) {
        Write-Log "No same-day log files found for $Agent. Waiting 1 minute before re-check..."
        Start-Sleep -Seconds 60

        $extensionsSecond = @("*.out", "*.tsv")
        $files = foreach ($ext in $extensionsSecond) {
            Get-ChildItem $SourcePath -Filter $ext -File -ErrorAction SilentlyContinue |
            Where-Object { $_.LastWriteTime.Date -eq $today }
        }

        if (-not $files -or $files.Count -eq 0) {
            Write-Log "ERROR: No same-day .out or .tsv files found for $Agent even after 1 minute wait. Exiting script."
            exit 1
        }
    }

    # -------- BACKUP --------
    foreach ($f in $files) {
        Copy-Item $f.FullName (Join-Path $AgentBackupPath $f.Name) -Force
        Write-Log "Backed up today's file $($f.Name) for $Agent"
    }
}
