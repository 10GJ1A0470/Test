    if (-not (Test-Path $PythonExe)) { Write-Log "Python executable not found: $PythonExe"; return $false }
    Write-Log "Running Python start: $PyPath"
    
    $output = & $PythonExe "`"$PyPath`"" 2>&1
    $output | ForEach-Object { Write-Log "[PY] $_" }
    
    if ($LASTEXITCODE -eq 0) {
        Write-Log "Python script completed successfully."
        return $true
    } else {
        Write-Log "Python script failed with exit code $LASTEXITCODE."
