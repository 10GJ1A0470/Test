# ---------------- FUNCTIONS ----------------
function Write-Log {
    param($Message)
    $line = "[{0}] {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Message
    $line | Tee-Object -FilePath $LogPath -Append
}

function Backup-OutFiles {
    param($Agent)

    $SourcePath = $outfile_path[$Agent]
    if (-not (Test-Path $SourcePath)) {
        Write-Log "WARNING: Outfile path not found for $Agent : $SourcePath"
        return
    }

    $AgentBackupPath = Join-Path $BackupBasePath $Agent
    if (-not (Test-Path $AgentBackupPath)) {
        New-Item -ItemType Directory -Path $AgentBackupPath -Force | Out-Null
        Write-Log "Created backup folder: $AgentBackupPath"
    }

    $files = Get-ChildItem $SourcePath -Filter "*.out" -File -ErrorAction SilentlyContinue
    if ($files.Count -eq 0) {
        Write-Log "No .out files found for $Agent"
        return
    }

    foreach ($f in $files) {
        Copy-Item $f.FullName (Join-Path $AgentBackupPath $f.Name) -Force
        Write-Log "Backed up $($f.Name) for $Agent"
    }
}

function Check-Agents {
    param($Agents)
    $cmdLines = wmic process where "name like '%ompeditor%'" get CommandLine /VALUE |
        Select-String "^CommandLine=" | ForEach-Object { $_ -replace "CommandLine=", "" }

    $down=@()
    foreach ($a in $Agents) {
        if (-not ($cmdLines -match [regex]::Escape($a))) { $down += $a }
    }
    return $down
}

# ---------------- MAIN ----------------
