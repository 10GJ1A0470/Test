# ---------------- FUNCTIONS ----------------

function Write-Log {
    param([string]$Message)
    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "[$time] $Message"
    Write-Output $line
    $line | Out-File -Append -FilePath $LogPath -Encoding UTF8
}

function Backup-OutFiles {
    param($Agent)

    $PrimaryPath   = $primaryoutfile_path[$Agent]
    $SecondaryPath = $secondaryoutfile_path[$Agent]
    $HostName = $env:COMPUTERNAME

    function Get-ValidSource($cutoffTime) {

        if ($PrimaryPath -and (Test-Path $PrimaryPath)) {
            $files = Get-ChildItem $PrimaryPath -File -ErrorAction SilentlyContinue |
                     Where-Object { $_.LastWriteTime -ge $cutoffTime -and $_.Extension -in ".out",".tsv" }
            if ($files.Count -ge 2) {
                return @{ Path = $PrimaryPath; Tag = "UNC" }
            }
        }

        if ($SecondaryPath -and (Test-Path $SecondaryPath)) {
            $files = Get-ChildItem $SecondaryPath -File -ErrorAction SilentlyContinue |
                     Where-Object { $_.LastWriteTime -ge $cutoffTime -and $_.Extension -in ".out",".tsv" }
            if ($files.Count -ge 2) {
                return @{ Path = $SecondaryPath; Tag = "Client" }
            }
        }

        return $null
    }

    $cutoffTime = (Get-Date).AddHours(-24)
    $result = Get-ValidSource $cutoffTime

    if (-not $result) {
        Write-Log "Files not found for $Agent. Waiting 1 minute..."
        Start-Sleep -Seconds 60
        $cutoffTime = (Get-Date).AddHours(-24)
        $result = Get-ValidSource $cutoffTime

        if (-not $result) {
            Write-Log "CRITICAL: Mandatory files still missing for $Agent"
            Send-EmailHtml -Subject "CRITICAL: $HostName Agent Logs Missing for $Agent" `
                           -HtmlBody "<h3>Mandatory logs missing. Script stopped.</h3>" `
                           -Recipients $ToInitial
            exit 1
        }
    }

    $SourcePath = $result.Path
    $SourceTag  = $result.Tag

    if (-not (Test-Path $backup_path)) {
        New-Item -ItemType Directory -Path $backup_path -Force | Out-Null
    }

    $RunTime = Get-Date -Format "yyyyMMdd_HHmmss"
    $RunBackupFolder = Join-Path $backup_path "${HostName}_${SourceTag}_${RunTime}"
    New-Item -ItemType Directory -Path $RunBackupFolder -Force | Out-Null

    $allFiles = Get-ChildItem $SourcePath -File -ErrorAction SilentlyContinue |
                Where-Object { $_.LastWriteTime -ge $cutoffTime -and $_.Extension -in ".out",".tsv",".wrn",".err" }

    foreach ($f in $allFiles) {
        Copy-Item $f.FullName (Join-Path $RunBackupFolder $f.Name) -Force
        Write-Log "BACKUP SUCCESS [$Agent] : $($f.Name)"
    }

    Write-Log "BACKUP COMPLETED for $Agent"
    return $RunBackupFolder
}

function Send-EmailHtml {
    param($Subject,$HtmlBody,$Recipients)
    if ([string]::IsNullOrWhiteSpace($Recipients)) { return }
    Send-MailMessage -From $From -To $Recipients -Subject $Subject -Body $HtmlBody -SmtpServer $SmtpServer -BodyAsHtml
}

function Check-Agents {
    param($Agents)

    $cmdLines = wmic process where "name like '%ompeditor%'" get CommandLine /VALUE |
        Select-String "^CommandLine=" | ForEach-Object {
            $_.ToString().Replace("CommandLine=", "").Trim()
        }

    $down = @()
    foreach ($a in $Agents) {
        $matched = $false
        foreach ($c in $cmdLines) {
            if ($c -match "/database=\{.*$([regex]::Escape($a)).*\}") { $matched = $true; break }
        }
        if (-not $matched) { $down += $a }
    }

    $html = "<html><body><h3>Agent Status</h3><table border='1'>"
    foreach ($a in $Agents) {
        if ($down -contains $a) {
            $html += "<tr><td>$a</td><td style='color:red'>DOWN</td></tr>"
        } else {
            $html += "<tr><td>$a</td><td style='color:green'>RUNNING</td></tr>"
        }
    }
    $html += "</table></body></html>"

    return @{ DownAgents=$down; Html=$html }
}

